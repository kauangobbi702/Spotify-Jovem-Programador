            "artistas_seguidos"
          ]
        },
        "description": "Lista os artistas seguidos pelo usuario autenticado."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Retorna HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Resposta e uma lista JSON', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
